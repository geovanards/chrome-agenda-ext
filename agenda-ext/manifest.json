{
  "manifest_version": 3,
  "name": "Agenda de Anotações",
  "version": "1.0",
  "description": "Uma extensão simples para salvar suas anotações.",
  "action": {
    "default_popup": "popup.html", 
    "default_icon": {
      "16": "img/icon16.png",
      "48": "img/icon48.png",
      "128": "img/icon128.png"
    }
  },
  "permissions": [
    "storage"
  ]
}